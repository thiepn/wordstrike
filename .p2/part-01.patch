+name: Mode customization browser regressions
+on:
+  pull_request:
+  push:
+    branches: [main]
+permissions:
+  contents: read
+jobs:
+  modes:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Install browser test dependencies
+        run: |
+          pip install -r tests/browser/requirements.txt
+          sudo rm -f /etc/apt/sources.list.d/google-chrome.list /etc/apt/sources.list.d/google-chrome.sources
+          python -m playwright install --with-deps chromium firefox
+      - name: Certify mode-local customization and unchanged gameplay geometry
+        run: python tests/browser/customization_p2.py
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: customization-p2-evidence
+          path: browser-artifacts/customization-p2/
+          retention-days: 14
